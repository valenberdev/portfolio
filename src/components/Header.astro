---
import type { Locale } from '../i18n/locale';
import { homePath } from '../i18n/routes';
import { t } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const home = homePath(locale);

const items = [
  { label: ui['nav.projects'], id: ui['section.projects'] },
  { label: ui['nav.experience'], id: ui['section.experience'] },
  { label: ui['nav.about'], id: ui['section.about'] },
  { label: ui['nav.contact'], id: ui['section.contact'] },
];
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={home}>valentino berdini</a>
    <nav aria-label={ui['nav.label']}>
      <ol>
        {
          items.map((item, index) => (
            <li>
              <a href={`${home}#${item.id}`}>
                <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <LangSwitch locale={locale} />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(13 15 20 / 0.72);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    margin-left: auto;
    overflow-x: auto;
  }

  ol {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-flex;
    gap: var(--space-2);
    align-items: baseline;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--fg);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
  }

  @media (max-width: 48rem) {
    .bar {
      gap: var(--space-3);
    }

    .brand {
      display: none;
    }

    nav {
      margin-left: 0;
      flex: 1;
    }

    ol {
      gap: var(--space-4);
    }
  }
</style>