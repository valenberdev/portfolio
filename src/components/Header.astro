---
import type { Locale } from '../i18n/locale';
import { homePath } from '../i18n/routes';
import { t } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const home = homePath(locale);

const items = [
  { label: ui['nav.projects'], id: ui['section.projects'] },
  { label: ui['nav.experience'], id: ui['section.experience'] },
  { label: ui['nav.about'], id: ui['section.about'] },
  { label: ui['nav.contact'], id: ui['section.contact'] },
];
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={home}>valentino berdini</a>
    <nav aria-label={ui['nav.label']}>
      <ol>
        {
          items.map((item, index) => (
            <li>
              <a href={`${home}#${item.id}`}>
                <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <LangSwitch locale={locale} />
  </div>
  <span class="progress" aria-hidden="true"></span>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(11 10 9 / 0.6);
    backdrop-filter: blur(14px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }

  ol {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-flex;
    gap: var(--space-2);
    align-items: baseline;
    padding-block: var(--space-2);
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s var(--ease-out);
  }

  nav a:hover {
    color: var(--fg);
  }

  .label {
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 1px no-repeat;
    padding-bottom: 2px;
    transition: background-size 0.45s var(--ease-out);
  }

  nav a:hover .label {
    background-size: 100% 1px;
  }

  .num {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .progress {
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .header {
        background: transparent;
        backdrop-filter: none;
        animation: header-solid linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 10rem;
      }

      .progress {
        animation: progress linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes header-solid {
    to {
      background: rgb(11 10 9 / 0.72);
      backdrop-filter: blur(14px);
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 48rem) {
    .bar {
      gap: var(--space-3);
    }

    .brand {
      display: none;
    }

    nav {
      margin-left: 0;
      flex: 1;
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }

    nav a {
      font-size: 0.85rem;
    }

    ol {
      gap: var(--space-4);
      padding-right: var(--space-5);
    }
  }
</style>
