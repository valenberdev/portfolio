---
import { render } from 'astro:content';
import type { Locale } from '../../i18n/locale';
import { homePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Project } from '../../lib/content';
import Arrow from '../Arrow.astro';
import StatusBadge from '../home/StatusBadge.astro';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const { slug, entry } = project;
const { title, summary, role, stack, status, team, links, note } = entry.data;
const ui = t(locale);
const { Content } = await render(entry);
const backHref = `${homePath(locale)}#${ui['section.projects']}`;
---

<BaseLayout locale={locale} title={`${title} — Valentino Berdini`} description={summary}>
  <article class="container detail">
    <a class="back" href={backHref}>
      <Arrow direction="right" />
      {ui['detail.back']}
    </a>
    <header class="head">
      <StatusBadge locale={locale} status={status} team={team} />
      <h1 transition:name={`project-${slug}`}>{title}</h1>
      <p class="summary">{summary}</p>
      <p class="role">{role}</p>
      <ul class="stack">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
      {note && <p class="note">{note}</p>}
      {
        (links.demo || links.repo) && (
          <div class="links">
            {links.demo && (
              <a class="button primary" href={links.demo} target="_blank" rel="noopener noreferrer">
                {ui['link.demo']}
                <Arrow />
              </a>
            )}
            {links.repo && (
              <a class="button" href={links.repo} target="_blank" rel="noopener noreferrer">
                {ui['link.repo']}
                <Arrow />
              </a>
            )}
          </div>
        )
      }
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .detail {
    padding-block: var(--space-7) var(--space-8);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-7);
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s var(--ease-out);
  }

  .back :global(svg) {
    transform: rotate(180deg);
  }

  .back:hover {
    color: var(--fg);
  }

  .back:hover :global(svg) {
    transform: rotate(180deg) translateX(3px);
  }

  .head {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-bottom: var(--space-7);
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--border);
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(3rem, 12vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.92;
    overflow-wrap: break-word;
  }

  .summary {
    max-width: 40rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .role {
    margin: 0;
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .stack li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-3);
    color: var(--border-strong);
  }

  .note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--warning);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .body {
    max-width: 44rem;
    font-size: var(--fs-body);
  }

  .body :global(h2) {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--fg);
  }

  .body :global(p),
  .body :global(li) {
    color: var(--muted);
  }

  .body :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .body :global(ul) {
    padding-left: 1.1rem;
  }

  .body :global(li) {
    margin-bottom: var(--space-3);
  }

  .body :global(a) {
    color: var(--fg);
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.3em;
  }

  .body :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .back,
    .head > :not(h1),
    .body {
      animation: detail-in 0.9s var(--ease-out) both;
    }

    .head > :nth-child(3) {
      animation-delay: 0.1s;
    }

    .head > :nth-child(n + 4) {
      animation-delay: 0.18s;
    }

    .body {
      animation-delay: 0.3s;
    }
  }

  @keyframes detail-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
</style>
