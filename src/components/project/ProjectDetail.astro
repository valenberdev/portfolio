---
import { render } from 'astro:content';
import type { Locale } from '../../i18n/locale';
import { homePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Project } from '../../lib/content';
import StatusBadge from '../home/StatusBadge.astro';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const { slug, entry } = project;
const { title, summary, role, stack, status, team, links, note } = entry.data;
const ui = t(locale);
const { Content } = await render(entry);
const backHref = `${homePath(locale)}#${ui['section.projects']}`;
---

<BaseLayout locale={locale} title={`${title} — Valentino Berdini`} description={summary}>
  <article class="container detail">
    <a class="back" href={backHref}>← {ui['detail.back']}</a>
    <header class="head">
      <StatusBadge locale={locale} status={status} team={team} />
      <h1 transition:name={`project-${slug}`}>{title}</h1>
      <p class="summary">{summary}</p>
      <p class="role">{role}</p>
      <ul class="stack">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
      {note && <p class="note">{note}</p>}
      {
        (links.demo || links.repo) && (
          <div class="links">
            {links.demo && (
              <a class="button primary" href={links.demo} target="_blank" rel="noopener noreferrer">
                {ui['link.demo']} ↗
              </a>
            )}
            {links.repo && (
              <a class="button" href={links.repo} target="_blank" rel="noopener noreferrer">
                {ui['link.repo']} ↗
              </a>
            )}
          </div>
        )
      }
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .detail {
    max-width: 48rem;
    padding-block: var(--space-7) var(--space-8);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-6);
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--fg);
  }

  .head {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .summary {
    font-size: 1.25rem;
    margin: 0;
  }

  .role {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    margin: 0;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
  }

  .note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--warning);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .button {
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-size: 0.95rem;
    transition: background 0.2s, color 0.2s;
  }

  .button:hover {
    background: var(--surface-2);
  }

  .button.primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .button.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--fg);
  }

  .body {
    font-size: 1.05rem;
  }

  .body :global(h2) {
    font-size: 1rem;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-top: var(--space-6);
  }

  .body :global(p),
  .body :global(li) {
    color: var(--muted);
  }

  .body :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .body :global(ul) {
    padding-left: 1.1rem;
  }

  .body :global(li) {
    margin-bottom: var(--space-3);
  }
</style>