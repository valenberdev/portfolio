---
import type { Locale } from '../i18n/locale';
import { otherLocale, switchLocalePath } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const target = otherLocale(locale);
---

<a class="lang" href={switchLocalePath(Astro.url.pathname)} hreflang={target} lang={target} aria-label={t(locale)['langSwitch.label']}>
  <span aria-hidden="true">{target.toUpperCase()}</span>
</a>

<style>
  .lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--fg);
    transition: background 0.2s;
  }

  .lang:hover {
    background: var(--surface-2);
  }
</style>