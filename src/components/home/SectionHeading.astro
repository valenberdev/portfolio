---
interface Props {
  number: number;
  title: string;
}

const { number, title } = Astro.props;
---

<h2 class="heading" data-reveal>
  <span class="num" aria-hidden="true">{String(number).padStart(2, '0')}</span>
  {title}
</h2>

<style>
  .heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: var(--space-6);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
  }
</style>