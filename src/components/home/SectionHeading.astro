---
interface Props {
  number: number;
  title: string;
}

const { number, title } = Astro.props;
---

<h2 class="heading" data-reveal="heading">
  {title}
  <span class="num" aria-hidden="true">{String(number).padStart(2, '0')}</span>
</h2>

<style>
  .heading {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    font-size: var(--fs-section);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .num {
    margin-top: 0.35em;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--accent);
  }
</style>
