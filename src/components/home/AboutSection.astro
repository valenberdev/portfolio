---
import type { Locale } from '../../i18n/locale';
import { t } from '../../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);

const groups = [
  { label: ui['about.group.backend'], items: ['Node.js', 'Express', 'Java 21', 'Spring Boot', 'PostgreSQL'] },
  { label: ui['about.group.frontend'], items: ['React', 'TypeScript', 'Next.js', 'Astro', 'Capacitor'] },
  { label: ui['about.group.testing'], items: ['Vitest', 'Jest', 'JUnit 5', 'Testcontainers'] },
  { label: ui['about.group.infra'], items: ['Docker', 'GitHub Actions', 'Vercel', 'AWS SES'] },
];
---

<section id={ui['section.about']} class="container section">
  <SectionHeading number={3} title={ui['nav.about']} />
  <div class="layout">
    <div class="text" data-reveal="row">
      <p>{ui['about.p1']}</p>
      <p>{ui['about.p2']}</p>
    </div>
    <dl class="groups" data-reveal="row">
      {
        groups.map((group) => (
          <div class="group">
            <dt>{group.label}</dt>
            <dd>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: var(--space-7);
  }

  .text p:first-child {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin-bottom: var(--space-6);
  }

  .text p:last-child {
    max-width: 38rem;
    font-size: var(--fs-lead);
    color: var(--muted);
  }

  .groups {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }

  .group {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
  }

  dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  dd {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 1.05rem;
  }

  li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-3);
    color: var(--border-strong);
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-8);
    }
  }
</style>
