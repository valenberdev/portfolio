---
import type { Locale } from '../../i18n/locale';
import { t } from '../../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);

const groups = [
  { label: ui['about.group.backend'], items: ['Node.js', 'Express', 'Java 21', 'Spring Boot', 'PostgreSQL'] },
  { label: ui['about.group.frontend'], items: ['React', 'TypeScript', 'Next.js', 'Astro', 'Capacitor'] },
  { label: ui['about.group.testing'], items: ['Vitest', 'Jest', 'JUnit 5', 'Testcontainers'] },
  { label: ui['about.group.infra'], items: ['Docker', 'GitHub Actions', 'Vercel', 'AWS SES'] },
];
---

<section id={ui['section.about']} class="container section">
  <SectionHeading number={3} title={ui['nav.about']} />
  <div class="layout">
    <div class="text" data-reveal>
      <p>{ui['about.p1']}</p>
      <p>{ui['about.p2']}</p>
    </div>
    <dl class="groups" data-reveal>
      {
        groups.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-7);
  }

  .text p {
    font-size: 1.15rem;
    color: var(--muted);
  }

  .text p:first-child {
    color: var(--fg);
  }

  .groups {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  dd {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
  }

  @media (max-width: 48rem) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>