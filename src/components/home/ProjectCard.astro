---
import type { Locale } from '../../i18n/locale';
import { projectPath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import type { Project } from '../../lib/content';
import Arrow from '../Arrow.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const { slug, entry } = project;
const { title, summary, stack, status, team, links, note } = entry.data;
const ui = t(locale);
const href = projectPath(locale, slug);
---

<article class="card" data-reveal="row">
  <div class="head">
    <StatusBadge locale={locale} status={status} team={team} />
    <h3 transition:name={`project-${slug}`}>
      <a href={href}>{title}</a>
    </h3>
  </div>
  <div class="info">
    <p class="summary">{summary}</p>
    <ul class="stack">
      {stack.map((item) => <li>{item}</li>)}
    </ul>
    {note && <p class="note">{note}</p>}
    <div class="actions">
      <a class="details" href={href}>
        {ui['card.details']}
        <Arrow direction="right" />
      </a>
      {
        links.demo && (
          <a class="external" href={links.demo} target="_blank" rel="noopener noreferrer">
            {ui['link.demo']}
            <Arrow />
          </a>
        )
      }
      {
        links.repo && (
          <a class="external" href={links.repo} target="_blank" rel="noopener noreferrer">
            {ui['link.repo']}
            <Arrow />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid var(--border);
  }

  .card::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
  }

  .card:hover::before,
  .card:has(h3 a:focus-visible)::before {
    transform: scaleX(1);
  }

  .head {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  h3 {
    margin: 0;
    font-size: var(--fs-title);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  h3 a {
    display: inline-block;
    text-decoration: none;
    transition:
      transform 0.6s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover h3 a {
    transform: translateX(0.5rem);
    color: var(--accent);
  }

  .info {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .summary {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--fg);
  }

  .stack li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-3);
    color: var(--border-strong);
  }

  .note {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--warning);
  }

  .actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding-top: var(--space-2);
    font-size: 0.95rem;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition:
      color 0.3s var(--ease-out),
      text-decoration-color 0.3s var(--ease-out);
  }

  .actions a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  .actions .details {
    color: var(--fg);
  }

  .card:hover .details :global(svg) {
    transform: translateX(3px);
  }

  .actions .external:hover :global(svg) {
    transform: translate(2px, -2px);
  }

  @media (min-width: 60rem) {
    .card {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-7);
    }
  }
</style>
