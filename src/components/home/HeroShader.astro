<div class="shader" transition:persist="hero-shader">
  <canvas data-hero-shader aria-hidden="true"></canvas>
</div>

<script>
  import { FRAGMENT_SHADER } from '../../scripts/shader/fragment';
  import { pixelRatioFor, shouldAnimate } from '../../scripts/shader/policy';
  import { createShaderRenderer, type ShaderRenderer } from '../../scripts/shader/renderer';

  let canvas: HTMLCanvasElement | null = null;
  let renderer: ShaderRenderer | null = null;
  let cleanup: (() => void) | null = null;

  function teardown() {
    cleanup?.();
    renderer?.destroy();
    cleanup = null;
    renderer = null;
    canvas = null;
  }

  function mount() {
    const next = document.querySelector<HTMLCanvasElement>('[data-hero-shader]');
    if (next && next === canvas && renderer) return;
    teardown();
    if (!next) return;

    const env = {
      reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      webgl: typeof WebGLRenderingContext !== 'undefined',
    };
    if (!shouldAnimate(env)) return;

    const isMobile = window.matchMedia('(pointer: coarse)').matches;
    const created = createShaderRenderer(next, FRAGMENT_SHADER, pixelRatioFor(window.devicePixelRatio, isMobile));
    if (!created) return;

    canvas = next;
    renderer = created;
    const current = created;

    const onPointerMove = (event: PointerEvent) => {
      const rect = next.getBoundingClientRect();
      current.setPointer((event.clientX - rect.left) / rect.width, 1 - (event.clientY - rect.top) / rect.height);
    };
    const onLost = () => next.classList.remove('is-ready');
    const resizeObserver = new ResizeObserver(() => current.resize());
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) current.start();
      else current.stop();
    });

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    next.addEventListener('shader:lost', onLost);
    resizeObserver.observe(next);
    visibilityObserver.observe(next);
    next.classList.add('is-ready');

    cleanup = () => {
      window.removeEventListener('pointermove', onPointerMove);
      next.removeEventListener('shader:lost', onLost);
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
      next.classList.remove('is-ready');
    };
  }

  document.addEventListener('astro:page-load', mount);
</script>

<style>
  .shader {
    position: absolute;
    inset: 0;
  }

  canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  canvas.is-ready {
    opacity: 1;
  }
</style>