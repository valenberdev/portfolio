---
import type { Locale } from '../../i18n/locale';
import { t } from '../../i18n/ui';
import type { Project } from '../../lib/content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
  projects: Project[];
}

const { locale, projects } = Astro.props;
const ui = t(locale);
---

<section id={ui['section.projects']} class="container section">
  <SectionHeading number={1} title={ui['nav.projects']} />
  <div class="list">
    {projects.map((project) => <ProjectCard locale={locale} project={project} />)}
  </div>
</section>

<style>
  .list {
    border-bottom: 1px solid var(--border);
  }
</style>
