---
import type { Locale } from '../../i18n/locale';
import { t } from '../../i18n/ui';
import type { Project } from '../../lib/content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
  projects: Project[];
}

const { locale, projects } = Astro.props;
const ui = t(locale);
---

<section id={ui['section.projects']} class="container section">
  <SectionHeading number={1} title={ui['nav.projects']} />
  <div class="grid">
    {projects.map((project) => <ProjectCard locale={locale} project={project} />)}
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
  }
</style>