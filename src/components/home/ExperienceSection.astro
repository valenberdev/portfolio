---
import { render } from 'astro:content';
import type { Locale } from '../../i18n/locale';
import { t } from '../../i18n/ui';
import type { Experience } from '../../lib/content';
import Arrow from '../Arrow.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
  items: Experience[];
}

const { locale, items } = Astro.props;
const ui = t(locale);
const formatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-AR' : 'en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

function formatMonth(value: string): string {
  return formatter.format(new Date(`${value}-01T00:00:00Z`));
}

const rendered = await Promise.all(
  items.map(async (item) => ({ ...item, Content: (await render(item.entry)).Content })),
);
---

<section id={ui['section.experience']} class="container section">
  <SectionHeading number={2} title={ui['nav.experience']} />
  {
    rendered.map(({ entry, Content }) => (
      <article class="job" data-reveal="row">
        <header>
          <p class="period">
            {formatMonth(entry.data.start)} — {entry.data.end ? formatMonth(entry.data.end) : ui['experience.present']}
          </p>
          <h3>{entry.data.company}</h3>
          <p class="role">{entry.data.role}</p>
          <ul class="stack">
            {entry.data.stack.map((item) => <li>{item}</li>)}
          </ul>
          {entry.data.links.store && (
            <a class="store" href={entry.data.links.store} target="_blank" rel="noopener noreferrer">
              {ui['link.store']}
              <Arrow />
            </a>
          )}
          {entry.data.note && <p class="note">{entry.data.note}</p>}
        </header>
        <div class="body">
          <p class="summary">{entry.data.summary}</p>
          <Content />
        </div>
      </article>
    ))
  }
</section>

<style>
  .job {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(1.75rem, 4vw, 3rem);
    border-block: 1px solid var(--border);
  }

  .period {
    margin-bottom: var(--space-4);
    font-size: var(--fs-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h3 {
    margin-bottom: var(--space-2);
    font-size: var(--fs-title);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .role {
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .stack li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-3);
    color: var(--border-strong);
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition: text-decoration-color 0.3s var(--ease-out);
  }

  .store:hover {
    text-decoration-color: var(--fg);
  }

  .store:hover :global(svg) {
    transform: translate(2px, -2px);
  }

  .note {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
    color: var(--warning);
  }

  .body {
    max-width: 44rem;
  }

  .summary {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .body :global(h2) {
    margin-top: var(--space-6);
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .body :global(ul) {
    padding-left: 1.1rem;
    color: var(--muted);
  }

  .body :global(li) {
    margin-bottom: var(--space-2);
  }

  @media (min-width: 60rem) {
    .job {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-7);
    }
  }
</style>
