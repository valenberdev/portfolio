---
import { render } from 'astro:content';
import type { Locale } from '../../i18n/locale';
import { t } from '../../i18n/ui';
import type { Experience } from '../../lib/content';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
  items: Experience[];
}

const { locale, items } = Astro.props;
const ui = t(locale);
const formatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-AR' : 'en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

function formatMonth(value: string): string {
  return formatter.format(new Date(`${value}-01T00:00:00Z`));
}

const rendered = await Promise.all(
  items.map(async (item) => ({ ...item, Content: (await render(item.entry)).Content })),
);
---

<section id={ui['section.experience']} class="container section">
  <SectionHeading number={2} title={ui['nav.experience']} />
  {
    rendered.map(({ entry, Content }) => (
      <article class="job" data-reveal>
        <header>
          <p class="period">
            {formatMonth(entry.data.start)} — {entry.data.end ? formatMonth(entry.data.end) : ui['experience.present']}
          </p>
          <h3>{entry.data.company}</h3>
          <p class="role">{entry.data.role}</p>
          <ul class="stack">
            {entry.data.stack.map((item) => <li>{item}</li>)}
          </ul>
          {entry.data.links.store && (
            <a class="store" href={entry.data.links.store} target="_blank" rel="noopener noreferrer">
              {ui['link.store']} ↗
            </a>
          )}
          {entry.data.note && <p class="note">{entry.data.note}</p>}
        </header>
        <div class="body">
          <p class="summary">{entry.data.summary}</p>
          <Content />
        </div>
      </article>
    ))
  }
</section>

<style>
  .job {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  h3 {
    font-size: 1.6rem;
    margin-bottom: var(--space-1);
  }

  .role {
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .store {
    font-size: 0.9rem;
    text-underline-offset: 4px;
  }

  .note {
    margin-top: var(--space-3);
    font-size: 0.8rem;
    color: var(--warning);
  }

  .summary {
    font-size: 1.1rem;
  }

  .body :global(h2) {
    font-size: 1rem;
    font-family: var(--font-mono);
    color: var(--accent);
    margin-top: var(--space-5);
  }

  .body :global(ul) {
    padding-left: 1.1rem;
    color: var(--muted);
  }

  .body :global(li) {
    margin-bottom: var(--space-2);
  }

  @media (max-width: 48rem) {
    .job {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: var(--space-5);
    }
  }
</style>