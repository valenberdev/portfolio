---
import type { Locale } from '../i18n/locale';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  size?: 'sm' | 'lg';
}

const { locale, size = 'sm' } = Astro.props;
const ui = t(locale);

const links = [
  { href: 'https://www.linkedin.com/in/valenberdini/', label: ui['contact.linkedin'], icon: 'linkedin', external: true },
  { href: 'https://github.com/valenberdev', label: ui['contact.github'], icon: 'github', external: true },
  { href: 'mailto:vaberdini@gmail.com', label: ui['contact.email'], icon: 'mail', external: false },
] as const;
---

<ul class:list={['contact', size]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.label}
          title={link.label}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {link.icon === 'linkedin' && (
              <>
                <path d="M8 11v5" />
                <path d="M8 8v.01" />
                <path d="M12 16v-5" />
                <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10" />
              </>
            )}
            {link.icon === 'github' && (
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            )}
            {link.icon === 'mail' && (
              <>
                <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10" />
                <path d="M3 7l9 6l9 -6" />
              </>
            )}
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s, transform 0.2s var(--ease-out);
  }

  a:hover {
    color: var(--fg);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .lg a {
    width: 3.25rem;
    height: 3.25rem;
  }

  .lg svg {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>